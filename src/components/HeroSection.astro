---
interface Props {
  titulo: string;
  subtitulo: string;
  badge?: string;
  ctaPrimario?: {
    texto: string;
    url: string;
  };
  ctaSecundario?: {
    texto: string;
    url: string;
  };
}

const {
  titulo,
  subtitulo,
  badge = "Teupasenti, El Paraíso · Honduras",
  ctaPrimario = { texto: "Explorar Café de Especialidad", url: "#cataduria" },
  ctaSecundario = { texto: "Nuestra Historia", url: "#origen" }
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="relative min-h-[85vh] lg:min-h-[90vh] flex items-center justify-center bg-tierra-900 text-tierra-50 px-4 sm:px-6 lg:px-8 py-20 overflow-hidden">
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <img
      src={`${base}/images/varias-01.jpg`}
      alt="Café de Especialidad Tierra India en grano"
      class="w-full h-full object-cover object-center scale-105 filter brightness-[0.35] contrast-110"
    />
    <div class="absolute inset-0 bg-linear-to-t from-tierra-900 via-tierra-900/70 to-transparent"></div>
    <div class="absolute inset-0 bg-linear-to-r from-verde-900/60 via-tierra-900/40 to-transparent"></div>
  </div>

  <div class="relative z-10 max-w-5xl mx-auto text-center space-y-8">
    
    <!-- Location Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-dorado-400/15 border border-dorado-400/30 text-dorado-400 text-xs sm:text-sm font-medium tracking-wide shadow-xs backdrop-blur-md">
      <span class="w-2 h-2 rounded-full bg-dorado-400 animate-pulse"></span>
      {badge}
    </div>

    <!-- Main Headings -->
    <div class="space-y-4">
      <h1 class="text-4xl sm:text-6xl lg:text-7xl font-serif font-bold tracking-tight text-white leading-[1.15]" set:html={titulo}>
      </h1>

      <p class="text-base sm:text-xl text-tierra-100/90 max-w-3xl mx-auto font-light leading-relaxed">
        {subtitulo}
      </p>
    </div>

    <!-- Action Buttons -->
    <div class="pt-2 flex flex-col sm:flex-row justify-center items-center gap-4">
      {ctaPrimario && (
        <a
          href={ctaPrimario.url}
          class="w-full sm:w-auto px-8 py-4 rounded-xl bg-dorado-500 hover:bg-dorado-400 text-tierra-900 font-semibold text-base transition duration-300 shadow-xl shadow-dorado-500/25 hover:-translate-y-0.5 whitespace-nowrap"
        >
          {ctaPrimario.texto}
        </a>
      )}
      {ctaSecundario && (
        <a
          href={ctaSecundario.url}
          class="w-full sm:w-auto px-8 py-4 rounded-xl border border-white/25 hover:border-white/50 bg-white/5 hover:bg-white/10 text-white font-medium text-base transition backdrop-blur-md hover:-translate-y-0.5 whitespace-nowrap"
        >
          {ctaSecundario.texto}
        </a>
      )}
    </div>

    <!-- Highlights Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 pt-10 border-t border-white/15 max-w-4xl mx-auto">
      <div class="p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md">
        <div class="text-2xl sm:text-3xl font-serif font-bold text-dorado-400">86.7</div>
        <div class="text-xs sm:text-sm text-tierra-100/75 mt-1 font-medium">Puntaje IHCAFE</div>
      </div>
      <div class="p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md">
        <div class="text-2xl sm:text-3xl font-serif font-bold text-dorado-400">1,500m</div>
        <div class="text-xs sm:text-sm text-tierra-100/75 mt-1 font-medium">Altitud</div>
      </div>
      <div class="p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md">
        <div class="text-2xl sm:text-3xl font-serif font-bold text-verde-500">100%</div>
        <div class="text-xs sm:text-sm text-tierra-100/75 mt-1 font-medium">Liderazgo Femenino</div>
      </div>
      <div class="p-4 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-md">
        <div class="text-2xl sm:text-3xl font-serif font-bold text-dorado-400">EUDR</div>
        <div class="text-xs sm:text-sm text-tierra-100/75 mt-1 font-medium">Cero Deforestación UE</div>
      </div>
    </div>

  </div>
</section>
