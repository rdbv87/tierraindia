---
import Icon from './Icon.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const navLinks = [
  { href: "/", label: "Inicio" },
  { href: "/#origen", label: "Historia & Origen" },
  { href: "/#cataduria", label: "Cataduría & Cafés" },
  { href: "/#premios", label: "Reconocimientos" },
  { href: "/#eventos", label: "Eventos & Bitácora" },
  { href: "/#contacto", label: "Contacto B2B" },
];

const instagramUrl = "https://www.instagram.com/tierra_india_s.a/";
const facebookUrl = "https://www.facebook.com/profile.php?id=100090678776887";
---

<header class="sticky top-0 z-50 bg-tierra-900/95 backdrop-blur-md border-b border-dorado-400/20 text-white transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 gap-4">
      
      <!-- Brand Logo con Grano SVG (2 líneas intencionales de identidad institucional) -->
      <a href="/" class="group flex items-center gap-3 focus:outline-hidden shrink-0">
        <div class="w-11 h-11 rounded-2xl bg-dorado-400/15 border border-dorado-400/40 flex items-center justify-center text-dorado-400 group-hover:bg-dorado-400/25 group-hover:scale-105 transition-all shadow-md shrink-0">
          <Icon name="coffee" class="w-6 h-6 text-dorado-400" />
        </div>
        <div class="flex flex-col whitespace-nowrap">
          <span class="font-serif font-bold text-lg sm:text-xl tracking-wide text-white group-hover:text-dorado-400 transition">
            Tierra India
          </span>
          <span class="text-[10px] sm:text-xs text-dorado-400 uppercase tracking-widest font-medium">
            Tostaduría & Cataduría
          </span>
        </div>
      </a>

      <!-- Desktop Nav (Garantizado en 1 sola línea estricta) -->
      <nav class="hidden 2xl:flex items-center gap-2">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="px-3.5 py-2 rounded-lg text-sm font-medium text-tierra-100/85 hover:text-white hover:bg-white/5 transition whitespace-nowrap"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Right Actions (Redes + Botón B2B en 1 sola línea) -->
      <div class="hidden 2xl:flex items-center gap-3 shrink-0">
        <div class="flex items-center gap-1.5 pr-3 border-r border-white/10">
          <a
            href={instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-xl bg-white/5 hover:bg-dorado-400/20 border border-white/10 hover:border-dorado-400/50 flex items-center justify-center text-tierra-100/80 hover:text-dorado-400 transition shrink-0"
            aria-label="Instagram de Tierra India"
            title="Instagram: @tierra_india_s.a"
          >
            <Icon name="instagram" class="w-4 h-4" />
          </a>
          <a
            href={facebookUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-xl bg-white/5 hover:bg-dorado-400/20 border border-white/10 hover:border-dorado-400/50 flex items-center justify-center text-tierra-100/80 hover:text-dorado-400 transition shrink-0"
            aria-label="Facebook de Tierra India"
            title="Facebook Oficial"
          >
            <Icon name="facebook" class="w-4 h-4" />
          </a>
        </div>

        <a
          href="/#contacto"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-dorado-500 hover:bg-dorado-400 text-tierra-900 text-sm font-bold transition shadow-md shadow-dorado-500/20 whitespace-nowrap shrink-0"
        >
          <span>Exportación & B2B</span>
          <Icon name="arrow-right" class="w-4 h-4 text-tierra-900" />
        </a>
      </div>

      <!-- Mobile & Laptop Menu Button (< 1536px para evitar cualquier quiebre de línea) -->
      <div class="2xl:hidden flex items-center gap-2">
        <a
          href={instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2.5 rounded-xl text-tierra-100/80 hover:text-dorado-400 bg-white/5 border border-white/10"
          aria-label="Instagram de Tierra India"
        >
          <Icon name="instagram" class="w-4 h-4" />
        </a>
        <a
          href={facebookUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2.5 rounded-xl text-tierra-100/80 hover:text-dorado-400 bg-white/5 border border-white/10"
          aria-label="Facebook de Tierra India"
        >
          <Icon name="facebook" class="w-4 h-4" />
        </a>
        <label
          for="mobile-menu-toggle"
          class="p-2.5 rounded-xl text-tierra-100 bg-white/5 hover:bg-white/10 border border-white/10 active:bg-white/20 cursor-pointer focus:outline-hidden ml-1"
          aria-label="Abrir menú de navegación"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </label>
      </div>

    </div>
  </div>

  <!-- Drawer Menu para pantallas donde no cabe en 1 sola línea -->
  <input type="checkbox" id="mobile-menu-toggle" class="peer hidden" />
  <div class="hidden peer-checked:block 2xl:hidden bg-tierra-900 border-b border-dorado-400/20 px-4 pt-4 pb-6 space-y-2.5 shadow-2xl transition-all">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block px-4 py-3 rounded-xl text-base font-medium text-tierra-100 hover:bg-white/10 active:bg-dorado-500/20 transition whitespace-nowrap"
      >
        {link.label}
      </a>
    ))}

    <!-- Social Links inside Drawer -->
    <div class="pt-4 pb-2 flex items-center justify-center gap-4 border-t border-white/10">
      <a
        href={instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white/5 text-tierra-100 text-sm hover:text-dorado-400 border border-white/10 whitespace-nowrap"
      >
        <Icon name="instagram" class="w-4 h-4 text-dorado-400" />
        <span>Instagram Oficial</span>
      </a>
      <a
        href={facebookUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white/5 text-tierra-100 text-sm hover:text-dorado-400 border border-white/10 whitespace-nowrap"
      >
        <Icon name="facebook" class="w-4 h-4 text-dorado-400" />
        <span>Facebook</span>
      </a>
    </div>

    <div class="pt-2">
      <a
        href="/#contacto"
        class="flex items-center justify-center gap-2 text-center w-full px-4 py-3.5 rounded-xl bg-dorado-500 hover:bg-dorado-400 text-tierra-900 font-bold text-sm transition shadow-lg whitespace-nowrap"
      >
        <span>Contacto B2B & Exportación</span>
        <Icon name="arrow-right" class="w-4 h-4 text-tierra-900" />
      </a>
    </div>
  </div>
</header>
