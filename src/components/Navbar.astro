---
import Icon from './Icon.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const navLinks = [
  { href: "/", label: "Inicio" },
  { href: "/#origen", label: "Historia & Origen" },
  { href: "/#cataduria", label: "Cataduría & Cafés" },
  { href: "/#premios", label: "Reconocimientos" },
  { href: "/#eventos", label: "Eventos & Bitácora" },
  { href: "/#contacto", label: "Contacto B2B" },
];

const instagramUrl = "https://www.instagram.com/tierra_india_s.a/";
const facebookUrl = "https://www.facebook.com/profile.php?id=100090678776887";
---

<header class="sticky top-0 z-50 bg-[#2b1810]/95 backdrop-blur-md border-b border-[#dfab3e]/20 text-white transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 gap-4">
      
      <!-- Brand Logo con Grano SVG (2 líneas intencionales de identidad) -->
      <a href="/" class="group flex items-center gap-3 focus:outline-hidden shrink-0">
        <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl bg-[#dfab3e]/15 border border-[#dfab3e]/40 flex items-center justify-center text-[#dfab3e] group-hover:bg-[#dfab3e]/25 group-hover:scale-105 transition-all shadow-md shrink-0">
          <Icon name="coffee" class="w-5 h-5 sm:w-6 sm:h-6 text-[#dfab3e]" />
        </div>
        <div class="flex flex-col whitespace-nowrap">
          <span class="font-serif font-bold text-lg sm:text-xl tracking-wide text-white group-hover:text-[#dfab3e] transition">
            Tierra India
          </span>
          <span class="text-[10px] sm:text-xs text-[#dfab3e] uppercase tracking-widest font-medium">
            Tostaduría & Cataduría
          </span>
        </div>
      </a>

      <!-- Desktop Nav (Garantizado en 1 sola línea estricta y con breakpoint xl) -->
      <nav class="hidden xl:flex items-center gap-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="px-3 py-2 rounded-lg text-sm font-medium text-[#f7f1eb]/85 hover:text-white hover:bg-white/5 transition whitespace-nowrap"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Right Actions (Redes + Botón B2B en 1 sola línea) -->
      <div class="hidden xl:flex items-center gap-3 shrink-0">
        <!-- Social Icons in Navbar -->
        <div class="flex items-center gap-1 pr-2 border-r border-white/10">
          <a
            href={instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-xl bg-white/5 hover:bg-[#dfab3e]/20 border border-white/10 hover:border-[#dfab3e]/50 flex items-center justify-center text-[#f7f1eb]/80 hover:text-[#dfab3e] transition shrink-0"
            aria-label="Instagram de Tierra India"
            title="Instagram: @tierra_india_s.a"
          >
            <Icon name="instagram" class="w-4 h-4" />
          </a>
          <a
            href={facebookUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-xl bg-white/5 hover:bg-[#dfab3e]/20 border border-white/10 hover:border-[#dfab3e]/50 flex items-center justify-center text-[#f7f1eb]/80 hover:text-[#dfab3e] transition shrink-0"
            aria-label="Facebook de Tierra India"
            title="Facebook Oficial"
          >
            <Icon name="facebook" class="w-4 h-4" />
          </a>
        </div>

        <a
          href="/#contacto"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#c99326] hover:bg-[#dfab3e] text-[#2b1810] text-sm font-bold transition shadow-md shadow-[#c99326]/20 whitespace-nowrap shrink-0"
        >
          <span>Exportación & B2B</span>
          <Icon name="arrow-right" class="w-4 h-4 text-[#2b1810]" />
        </a>
      </div>

      <!-- Mobile & Tablet Menu Button (< 1280px) -->
      <div class="xl:hidden flex items-center gap-2">
        <a
          href={instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-xl text-[#f7f1eb]/80 hover:text-[#dfab3e] bg-white/5 border border-white/10"
          aria-label="Instagram de Tierra India"
        >
          <Icon name="instagram" class="w-4 h-4" />
        </a>
        <a
          href={facebookUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-xl text-[#f7f1eb]/80 hover:text-[#dfab3e] bg-white/5 border border-white/10"
          aria-label="Facebook de Tierra India"
        >
          <Icon name="facebook" class="w-4 h-4" />
        </a>
        <label
          for="mobile-menu-toggle"
          class="p-2.5 rounded-xl text-[#f7f1eb] bg-white/5 hover:bg-white/10 border border-white/10 active:bg-white/20 cursor-pointer focus:outline-hidden ml-1"
          aria-label="Abrir menú de navegación"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </label>
      </div>

    </div>
  </div>

  <!-- Mobile & Tablet Drawer Menu CSS Only -->
  <input type="checkbox" id="mobile-menu-toggle" class="peer hidden" />
  <div class="hidden peer-checked:block xl:hidden bg-[#2b1810] border-b border-[#dfab3e]/20 px-4 pt-3 pb-6 space-y-2 shadow-2xl transition-all">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block px-4 py-3 rounded-xl text-base font-medium text-[#f7f1eb] hover:bg-white/10 active:bg-[#c99326]/20 transition whitespace-nowrap"
      >
        {link.label}
      </a>
    ))}

    <!-- Social Links inside Drawer -->
    <div class="pt-4 pb-2 flex items-center justify-center gap-4 border-t border-white/10">
      <a
        href={instagramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white/5 text-[#f7f1eb] text-sm hover:text-[#dfab3e] border border-white/10"
      >
        <Icon name="instagram" class="w-4 h-4 text-[#dfab3e]" />
        <span>Instagram Oficial</span>
      </a>
      <a
        href={facebookUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white/5 text-[#f7f1eb] text-sm hover:text-[#dfab3e] border border-white/10"
      >
        <Icon name="facebook" class="w-4 h-4 text-[#dfab3e]" />
        <span>Facebook</span>
      </a>
    </div>

    <div class="pt-2">
      <a
        href="/#contacto"
        class="flex items-center justify-center gap-2 text-center w-full px-4 py-3.5 rounded-xl bg-[#c99326] hover:bg-[#dfab3e] text-[#2b1810] font-bold text-sm transition shadow-lg"
      >
        <span>Contacto B2B & Exportación</span>
        <Icon name="arrow-right" class="w-4 h-4 text-[#2b1810]" />
      </a>
    </div>
  </div>
</header>
