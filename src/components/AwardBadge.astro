---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  premio: CollectionEntry<'premios'>;
}

const { premio } = Astro.props;
const { data } = premio;
---

<div class="relative bg-gradient-to-br from-white via-[#fef7e7]/40 to-[#f7f1eb] p-6 sm:p-8 rounded-3xl border border-[#dfab3e]/30 shadow-md hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
  <!-- Top Medal Icon & Year -->
  <div class="flex items-start justify-between gap-4 mb-4">
    <div class="w-12 h-12 rounded-2xl bg-[#c99326]/15 border border-[#dfab3e]/50 flex items-center justify-center text-[#c99326]">
      <Icon name="award" class="w-6 h-6 text-[#c99326]" />
    </div>
    <span class="px-3 py-1 rounded-full bg-[#dfab3e]/20 text-[#936712] font-bold text-xs tracking-wider">
      {data.anio}
    </span>
  </div>

  <!-- Recognition Body -->
  <div class="space-y-2">
    {data.posicion && (
      <div class="text-xs font-bold uppercase tracking-widest text-[#936712]">
        {data.posicion}
      </div>
    )}
    <h3 class="text-xl font-serif font-bold text-[#2b1810]">
      {data.titulo}
    </h3>
    <div class="text-xs font-semibold text-[#653b2a]">
      {data.certamen} · <span class="text-[#438265]">{data.categoria}</span>
    </div>
    <p class="text-sm text-[#44261c]/80 pt-2 leading-relaxed">
      {data.descripcion}
    </p>
  </div>

  <!-- Quality Stamp -->
  <div class="pt-6 mt-4 border-t border-[#dfab3e]/20 flex items-center justify-between text-xs text-[#8b533e]">
    <span class="font-medium">Certificación Oficial</span>
    <span class="inline-flex items-center gap-1 text-[#c99326] font-bold">
      <Icon name="check" class="w-3.5 h-3.5 text-[#c99326]" />
      <span>Calidad Verificada</span>
    </span>
  </div>
</div>
