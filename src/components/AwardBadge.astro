---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  premio: CollectionEntry<'premios'>;
}

const { premio } = Astro.props;
const { data } = premio;
---

<div class="relative bg-linear-to-br from-white via-dorado-100/40 to-tierra-100 p-6 sm:p-8 rounded-3xl border border-dorado-400/30 shadow-md hover:shadow-xl transition-all duration-300 flex flex-col justify-between">
  <!-- Top Medal Icon & Year -->
  <div class="flex items-start justify-between gap-4 mb-4">
    <div class="w-12 h-12 rounded-2xl bg-dorado-500/15 border border-dorado-400/50 flex items-center justify-center text-dorado-500">
      <Icon name="award" class="w-6 h-6 text-dorado-500" />
    </div>
    <span class="px-3 py-1 rounded-full bg-dorado-400/20 text-dorado-700 font-bold text-xs tracking-wider">
      {data.anio}
    </span>
  </div>

  <!-- Recognition Body -->
  <div class="space-y-2">
    {data.posicion && (
      <div class="text-xs font-bold uppercase tracking-widest text-dorado-700">
        {data.posicion}
      </div>
    )}
    <h3 class="text-xl font-serif font-bold text-tierra-900">
      {data.titulo}
    </h3>
    <div class="text-xs font-semibold text-tierra-700">
      {data.certamen} · <span class="text-verde-500">{data.categoria}</span>
    </div>
    <p class="text-sm text-tierra-800/80 pt-2 leading-relaxed">
      {data.descripcion}
    </p>
  </div>

  <!-- Quality Stamp -->
  <div class="pt-6 mt-4 border-t border-dorado-400/20 flex items-center justify-between text-xs text-tierra-600">
    <span class="font-medium">Certificación Oficial</span>
    <span class="inline-flex items-center gap-1 text-dorado-500 font-bold">
      <Icon name="check" class="w-3.5 h-3.5 text-dorado-500" />
      <span>Calidad Verificada</span>
    </span>
  </div>
</div>
