---
import Icon from './Icon.astro';

const year = new Date().getFullYear();
const instagramUrl = "https://www.instagram.com/tierra_india_s.a/";
const facebookUrl = "https://www.facebook.com/profile.php?id=100090678776887";
---

<footer class="bg-tierra-900 text-tierra-100 border-t border-dorado-400/20 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-white/10">
      
      <!-- Column 1: Brand & Identity -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-dorado-400/15 border border-dorado-400/40 flex items-center justify-center text-dorado-400 shadow-md">
            <Icon name="coffee" class="w-5 h-5 text-dorado-400" />
          </div>
          <div>
            <span class="font-serif font-bold text-lg text-white block">Tierra India S.A.</span>
            <span class="text-xs text-dorado-400 tracking-wider uppercase">Tostaduría & Especialidad</span>
          </div>
        </div>
        <p class="text-sm text-tierra-100/75 leading-relaxed">
          Empresa liderada por mujeres caficultoras y catadoras en Teupasenti, El Paraíso. Pasión, origen, equidad y café especial con trazabilidad certificada.
        </p>
      </div>

      <!-- Column 2: Navigation Links -->
      <div>
        <h4 class="text-sm font-serif font-bold text-dorado-400 uppercase tracking-wider mb-4">
          Navegación
        </h4>
        <ul class="space-y-2.5 text-sm text-tierra-100/80">
          <li><a href="/" class="hover:text-dorado-400 transition">Inicio</a></li>
          <li><a href="/#origen" class="hover:text-dorado-400 transition">Historia & Sostenibilidad</a></li>
          <li><a href="/#cataduria" class="hover:text-dorado-400 transition">Cataduría & Fichas Técnicas</a></li>
          <li><a href="/#premios" class="hover:text-dorado-400 transition">Premios & Certificaciones</a></li>
          <li><a href="/#eventos" class="hover:text-dorado-400 transition">Bitácora & Eventos</a></li>
          <li><a href="/#contacto" class="hover:text-dorado-400 transition">Contacto B2B & Exportación</a></li>
        </ul>
      </div>

      <!-- Column 3: Contact & Location -->
      <div>
        <h4 class="text-sm font-serif font-bold text-dorado-400 uppercase tracking-wider mb-4">
          Ubicación & Contacto
        </h4>
        <div class="space-y-3 text-sm text-tierra-100/80">
          <div class="flex items-start gap-2.5">
            <Icon name="map-pin" class="w-4 h-4 text-dorado-400 shrink-0 mt-0.5" />
            <span>Barrio 1 de Mayo, Teupasenti, El Paraíso, Honduras.</span>
          </div>
          <div class="flex items-center gap-2.5">
            <Icon name="cup" class="w-4 h-4 text-dorado-400 shrink-0" />
            <span>Tostaduría física & Sala de Catación</span>
          </div>
          <div class="flex items-center gap-2.5">
            <Icon name="mail" class="w-4 h-4 text-dorado-400 shrink-0" />
            <span>contacto@tierraindia.hn (Ventas B2B)</span>
          </div>
        </div>
      </div>

      <!-- Column 4: Social Channels & Diversification -->
      <div>
        <h4 class="text-sm font-serif font-bold text-dorado-400 uppercase tracking-wider mb-4">
          Comunidad & Redes
        </h4>
        <p class="text-xs text-tierra-100/70 leading-relaxed mb-4">
          Síguenos en nuestras cuentas oficiales para conocer los nuevos tuestes, eventos y actividades de la tostaduría en Teupasenti.
        </p>
        <div class="flex gap-3">
          <a
            href={instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-xl bg-white/5 hover:bg-dorado-400/20 border border-white/10 hover:border-dorado-400/50 flex items-center justify-center text-white hover:text-dorado-400 transition shadow-md"
            aria-label="Instagram de Tierra India"
            title="Instagram: @tierra_india_s.a"
          >
            <Icon name="instagram" class="w-5 h-5" />
          </a>
          <a
            href={facebookUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-xl bg-white/5 hover:bg-dorado-400/20 border border-white/10 hover:border-dorado-400/50 flex items-center justify-center text-white hover:text-dorado-400 transition shadow-md"
            aria-label="Facebook de Tierra India"
            title="Facebook Oficial"
          >
            <Icon name="facebook" class="w-5 h-5" />
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-tierra-100/60">
      <div>
        © {year} Tostaduría Tierra India S.A. Todos los derechos reservados.
      </div>
      <div class="flex gap-4 items-center">
        <span>Café Especial 86.7 IHCAFE</span>
        <span>•</span>
        <span>Teupasenti, El Paraíso</span>
      </div>
    </div>

  </div>
</footer>
